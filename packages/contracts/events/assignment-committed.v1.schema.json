{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/assignment-committed.v1.schema.json",
  "title": "AssignmentCommitted v1 payload",
  "description": "Assignment committed and trip created; offer_id is empty for a broadcast claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "assignment_id",
    "driver_id",
    "source",
    "offer_id"
  ],
  "properties": {
    "order_id": {"type": "string", "format": "uuid"},
    "assignment_id": {"type": "string", "format": "uuid"},
    "driver_id": {"type": "string", "format": "uuid"},
    "source": {"type": "string"},
    "offer_id": {"type": "string"}
  }
}
