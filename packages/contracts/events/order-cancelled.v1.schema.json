{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/order-cancelled.v1.schema.json",
  "title": "OrderCancelled v1 payload",
  "description": "Order cancelled; reason labels are a snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "cancelled_by",
    "reason_code",
    "reason_labels"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "cancelled_by": {
      "type": "string"
    },
    "reason_code": {
      "type": "string"
    },
    "reason_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "driver_id": {
      "type": "string",
      "format": "uuid"
    },
    "trip_id": {
      "type": "string",
      "format": "uuid"
    },
    "fault": {
      "type": "string",
      "enum": [
        "CLIENT_FREE",
        "CLIENT",
        "DRIVER",
        "OPERATOR",
        "NONE"
      ],
      "description": "Who is at fault (ADR 0019): CLIENT_FREE — the client within the free window or before a driver; CLIENT — the client otherwise; DRIVER; OPERATOR; NONE — nobody. Left out before ADR 0019."
    },
    "driver_late": {
      "type": "boolean",
      "const": true,
      "description": "The fault is the driver's because the driver was late (ADR 0019); left out otherwise."
    }
  },
  "examples": [
    {
      "order_id": "a8797866-1eaa-4c26-b64f-215469cb37b6",
      "reason_code": "CHANGED_MIND",
      "cancelled_by": "RIDER",
      "reason_labels": {
        "en": "Changed my mind",
        "pl": "Zmiana planów",
        "ru": "Передумал ехать",
        "uk": "Передумав їхати"
      }
    }
  ]
}
