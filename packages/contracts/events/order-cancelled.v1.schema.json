{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/order-cancelled.v1.schema.json",
  "title": "OrderCancelled v1 payload",
  "description": "Order cancelled; reason labels are a snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "cancelled_by",
    "reason_code",
    "reason_labels"
  ],
  "properties": {
    "order_id": {"type": "string", "format": "uuid"},
    "cancelled_by": {"type": "string"},
    "reason_code": {"type": "string"},
    "reason_labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "driver_id": {"type": "string", "format": "uuid"},
    "trip_id": {"type": "string", "format": "uuid"}
  },
  "examples": [{"order_id": "a8797866-1eaa-4c26-b64f-215469cb37b6", "reason_code": "CHANGED_MIND", "cancelled_by": "RIDER", "reason_labels": {"en": "Changed my mind", "pl": "Zmiana planów", "ru": "Передумал ехать", "uk": "Передумав їхати"}}]
}
