{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/trip-started.v1.schema.json",
  "title": "TripStarted v1 payload",
  "description": "Trip moved to IN_PROGRESS, optionally with a confirmed exception.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "trip_id"
  ],
  "properties": {
    "order_id": {"type": "string", "format": "uuid"},
    "trip_id": {"type": "string", "format": "uuid"},
    "exception": {"type": "string"}
  }
}
