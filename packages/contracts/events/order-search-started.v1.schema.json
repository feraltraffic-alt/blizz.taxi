{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/order-search-started.v1.schema.json",
  "title": "OrderSearchStarted v1 payload",
  "description": "New dispatch attempt started.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "attempt_id",
    "generation",
    "search_seconds"
  ],
  "properties": {
    "order_id": {"type": "string", "format": "uuid"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "generation": {"type": "integer", "minimum": 0},
    "search_seconds": {"type": "integer", "minimum": 0}
  }
}
