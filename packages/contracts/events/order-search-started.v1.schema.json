{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/order-search-started.v1.schema.json",
  "title": "OrderSearchStarted v1 payload",
  "description": "New dispatch attempt started.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "attempt_id",
    "generation",
    "search_seconds"
  ],
  "properties": {
    "order_id": {"type": "string", "format": "uuid"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "generation": {"type": "integer", "minimum": 0},
    "search_seconds": {"type": "integer", "minimum": 0}
  },
  "examples": [{"order_id": "b83b8fa8-1f4c-40df-8a42-bf1f92a8187f", "attempt_id": "79ff4c1e-8227-4172-b493-7f799cbd4ced", "generation": 1, "search_seconds": 180}]
}
