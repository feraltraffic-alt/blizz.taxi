{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/cash-dispute-overdue.v1.schema.json",
  "title": "CashDisputeOverdue v1 payload",
  "description": "Published by finance once per cash dispute not decided by its deadline (14 days, owner decision 28.10.2026). Aggregate Order. Moves no money; backoffice opens an URGENT task.",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id", "driver_id", "held_minor", "rider_debt_minor", "currency", "decide_by"],
  "properties": {
    "order_id": { "type": "string", "format": "uuid" },
    "driver_id": { "type": "string", "format": "uuid" },
    "held_minor": { "type": "integer", "minimum": 0 },
    "rider_debt_minor": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "decide_by": { "type": "string", "format": "date-time" }
  },
  "examples": [
    { "order_id": "7b000000-0000-4000-8000-000000000094", "driver_id": "7e000000-0000-4000-8000-000000000094", "held_minor": 6800, "rider_debt_minor": 8000, "currency": "UAH", "decide_by": "2026-11-11T18:00:00Z" }
  ]
}
