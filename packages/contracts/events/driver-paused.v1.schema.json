{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/driver-paused.v1.schema.json",
  "title": "DriverPaused v1 payload",
  "description": "New offers and claims of the driver are paused until ends_at (ADR 0018): kind CANCELLATIONS — cancelling this accepted order made the count (B6, B7), with cancellations; ACCEPTANCE — the acceptance rate of personal offers fell below the pause threshold on this order's offer (B12.2), with acceptance_percent. Level 3 and more also raise a REPEATED_PAUSES risk flag. The driver gets a push.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "driver_id",
    "pause_id",
    "kind",
    "level",
    "ends_at"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "driver_id": {
      "type": "string",
      "format": "uuid"
    },
    "pause_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "CANCELLATIONS",
        "ACCEPTANCE"
      ]
    },
    "level": {
      "type": "integer",
      "minimum": 1
    },
    "cancellations": {
      "type": "integer",
      "minimum": 1
    },
    "acceptance_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "order_id": "0b1c2d3e-0000-4000-8000-000000000001",
      "driver_id": "0b1c2d3e-0000-4000-8000-000000000002",
      "pause_id": "0b1c2d3e-0000-4000-8000-000000000003",
      "kind": "CANCELLATIONS",
      "level": 1,
      "cancellations": 5,
      "ends_at": "2026-11-04T10:30:00Z"
    },
    {
      "order_id": "0b1c2d3e-0000-4000-8000-000000000001",
      "driver_id": "0b1c2d3e-0000-4000-8000-000000000002",
      "pause_id": "0b1c2d3e-0000-4000-8000-000000000004",
      "kind": "ACCEPTANCE",
      "level": 1,
      "acceptance_percent": 25,
      "ends_at": "2026-11-04T10:30:00Z"
    }
  ]
}
