{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/offer-revoked.v1.schema.json",
  "title": "OfferRevoked v1 payload",
  "description": "An open personal offer was withdrawn because its driver paused or closed the shift (AC-11, issue #141) or the driver's account was blocked (REQ-DS-01); dispatch goes on with the next driver. An accept of it after this gets 409 OFFER_REVOKED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "offer_id",
    "driver_id",
    "reason"
  ],
  "properties": {
    "order_id": {"type": "string", "format": "uuid"},
    "offer_id": {"type": "string", "format": "uuid"},
    "driver_id": {"type": "string", "format": "uuid"},
    "reason": {"type": "string", "enum": ["DRIVER_PAUSED", "DRIVER_CLOSED", "DRIVER_BLOCKED"]}
  },
  "examples": [
    {
      "order_id": "6f1c2a4e-3b9d-4f7a-9c1e-2d5b8a7f0e31",
      "offer_id": "0b7e4d2c-9a1f-4c3e-8d6b-5f2a1e9c7d40",
      "driver_id": "c3a9e1f7-2d4b-4e6a-b8c0-7f1d3e5a9b22",
      "reason": "DRIVER_PAUSED"
    }
  ]
}
