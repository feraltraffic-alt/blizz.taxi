{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/order-message-posted.v1.schema.json",
  "title": "OrderMessagePosted v1 payload",
  "description": "A chat message was stored (aggregate OrderChat, version = message sequence). The body is not in the event: the recipient fetches it through the API, so a notification never carries the text (REQ-NTF-04). recipient_id is null for a phone order without a rider account.",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id", "message_id", "sequence", "sender_role", "recipient_role", "recipient_id"],
  "properties": {
    "order_id": { "type": "string", "format": "uuid" },
    "message_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "sender_role": { "type": "string", "enum": ["RIDER", "DRIVER"] },
    "recipient_role": { "type": "string", "enum": ["RIDER", "DRIVER"] },
    "recipient_id": { "type": ["string", "null"], "format": "uuid" }
  },
  "examples": [
    {
      "order_id": "5f1e9a2c-4b7d-4c3e-8a19-2d6b7e0f1a34",
      "message_id": "6a7b8c9d-0e1f-4a2b-8c3d-4e5f6a7b8c9d",
      "sequence": 3,
      "sender_role": "DRIVER",
      "recipient_role": "RIDER",
      "recipient_id": "9a8b7c6d-5e4f-4a3b-8c2d-1e0f9a8b7c6d"
    }
  ]
}
