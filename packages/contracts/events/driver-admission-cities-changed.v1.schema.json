{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/driver-admission-cities-changed.v1.schema.json",
  "title": "DriverAdmissionCitiesChanged v1 payload",
  "description": "Staff changed the cities a driver is admitted in (REQ-DSP-01, issue #141). The driver gets new orders only in these.",
  "type": "object",
  "additionalProperties": false,
  "required": ["driver_id", "city_ids", "added", "removed"],
  "properties": {
    "driver_id": {"type": "string", "format": "uuid"},
    "city_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "added": {"type": "array", "items": {"type": "string", "format": "uuid"}},
    "removed": {"type": "array", "items": {"type": "string", "format": "uuid"}}
  },
  "examples": [
    {
      "driver_id": "c3a9e1f7-2d4b-4e6a-b8c0-7f1d3e5a9b22",
      "city_ids": ["5a000000-0000-4000-8000-000000000001"],
      "added": ["5a000000-0000-4000-8000-000000000001"],
      "removed": []
    }
  ]
}
