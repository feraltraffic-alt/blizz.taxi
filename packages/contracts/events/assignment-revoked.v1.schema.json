{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/assignment-revoked.v1.schema.json",
  "title": "AssignmentRevoked v1 payload",
  "description": "Staff revoked an assignment before the trip started.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "assignment_id",
    "driver_id"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "format": "uuid"
    },
    "assignment_id": {
      "type": "string",
      "format": "uuid"
    },
    "driver_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason_code": {
      "type": "string",
      "description": "The REASSIGN code staff gave (issue #143)."
    },
    "reason_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "The code's labels at the time."
    }
  }
}
