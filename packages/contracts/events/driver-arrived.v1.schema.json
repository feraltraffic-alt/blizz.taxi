{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.blizz.taxi/events/driver-arrived.v1.schema.json",
  "title": "DriverArrived v1 payload",
  "description": "Driver arrived; distance is unknown when location cannot be checked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "trip_id",
    "distance_m"
  ],
  "properties": {
    "order_id": {"type": "string", "format": "uuid"},
    "trip_id": {"type": "string", "format": "uuid"},
    "distance_m": {"oneOf": [{"type": "number", "minimum": 0}, {"const": "unknown"}]}
  }
}
